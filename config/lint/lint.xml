<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!-- Disable expensive and/or irrelevant checks. -->
    <issue id="DuplicateStrings" severity="ignore" />
    <issue id="GoogleAppIndexingApiWarning" severity="ignore" />
    <issue id="SelectableText" severity="ignore" />
    <issue id="SyntheticAccessor" severity="ignore" />
    <issue id="ImplicitSamInstance" severity="ignore" />
    <issue id="GradleDependency" severity="ignore" />

    <!-- Disable checks not working properly. -->
    <issue id="IconExpectedSize" severity="ignore" />
    <issue id="NullSafeMutableLiveData" severity="ignore" />
    <issue id="UnpackedNativeCode" severity="ignore" />

    <!-- Ignore errors about packages not contained in Android. These are safe. -->
    <issue id="InvalidPackage" severity="error">
        <ignore regexp=".*okio.*" />
        <ignore regexp=".*retrofit.*" />
        <ignore regexp="org.checkerframework.checker.signedness.SignednessUtil" />
    </issue>

    <!-- Gifs are not the best option performance-wise. Look later for a better alternative. -->
    <issue id="GifUsage">
        <ignore regexp="res/drawable-nodpi/o_.*[.]gif" />
    </issue>

    <!-- Ignore false positive about jsoup trusting all certificates. -->
    <!-- This is just a development tool, disabled by default and we do not even use the HTTP stack of Jsoup. -->
    <issue id="TrustAllX509TrustManager">
        <ignore regexp=".*org.jsoup.*" />
    </issue>

    <!-- Strings are mostly read in callbacks, where stringResource can't be used. -->
    <issue id="LocalContextGetResourceValueCall" severity="ignore" />
    <issue id="LocalContextResourcesRead" severity="ignore" />

    <!-- Keys of LaunchedEffects observing LiveData events, which are nullable Unit values on purpose. -->
    <issue id="OpaqueUnitKey" severity="ignore" />

    <!-- False positives: Compose's items extensions and Coil's directory extension are meant to be used. -->
    <issue id="MemberExtensionConflict" severity="ignore" />

    <!-- Slots like actions are named after their purpose. -->
    <issue id="ComposableLambdaParameterNaming" severity="ignore" />

    <!-- The toast helpers show the toast before returning it. -->
    <issue id="ShowToast" severity="ignore" />

    <!-- The deep links mirror the URLs of the website, which do not verify app links. -->
    <issue id="IntentFilterUniqueDataAttributes" severity="ignore" />
    <issue id="AppLinkWarning" severity="ignore" />

    <!-- Style suggestions, not issues. -->
    <issue id="UseKtx" severity="ignore" />
    <issue id="TypographyQuotes" severity="ignore" />
    <issue id="PluralsCandidate" severity="ignore" />
    <issue id="ConvertToWebp" severity="ignore" />
    <issue id="ReportShortcutUsage" severity="ignore" />

    <!-- The target and compile SDK are raised deliberately; the plugin version is pinned to the supported one. -->
    <issue id="OldTargetApi" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />

    <!-- The AutoDispose lint detector is not compatible with the current lint version. -->
    <issue id="LintError" severity="ignore" />

    <!-- Enable all lint checks with error severity, except for those listed above. -->
    <issue id="all" severity="error" />
</lint>
